# Copy to .env for development. In production the same variables go in
# /etc/tether/tether.env on the server (owned root:tether, mode 640).
# Never commit the real file.

# Generate with: uv run python -m tether keygen
TETHER_ENCRYPTION_KEY=
# Any long random string: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
TETHER_SESSION_SECRET=

# Google Cloud OAuth client (Web application type). Register
# <TETHER_BASE_URL>/auth/google/callback as an authorized redirect URI.
TETHER_GOOGLE_CLIENT_ID=
TETHER_GOOGLE_CLIENT_SECRET=

# Only this Google identity can sign in.
TETHER_OWNER_EMAIL=
# Optional pin: your Google account ID. The server logs it on first sign-in.
TETHER_OWNER_SUB=

# Public URL the browser uses (https://... in production, behind the reverse proxy).
TETHER_BASE_URL=http://localhost:8000
# Where `python -m tether serve` listens. Behind a proxy, keep the loopback bind.
TETHER_HOST=127.0.0.1
TETHER_PORT=8000

# OAuth redirect hosts the MCP connector may register (Claude, plus loopback for Claude Code).
TETHER_MCP_REDIRECT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1

TETHER_DB_PATH=tether.db
TETHER_STATIC_DIR=web/dist
TETHER_INITIAL_SYNC_DAYS=14

# Your time zone (IANA name, e.g. America/New_York). Decides what "due today" means.
TETHER_TIMEZONE=UTC

# Label for the work-digest account (a mailbox with no API access, pasted in as a digest).
TETHER_DIGEST_LABEL=Work

# Calendar hub. Create a secondary calendar by hand on one connected Google account,
# then give that account's address and the calendar's ID (Google Calendar > Settings >
# the calendar > Integrate calendar > Calendar ID). Leave empty to keep the agenda in Tether only.
TETHER_HUB_ACCOUNT=
TETHER_HUB_CALENDAR_ID=
# Published ICS feed (secret; e.g. Outlook > Settings > Calendar > Shared calendars > Publish).
TETHER_ICS_URL=
TETHER_ICS_LABEL=Work calendar

# Notifications (Web Push). The server's VAPID private key: make one with
# `python -m tether vapid-key`. Leave empty to turn notifications off.
# Changing it later stops every device's notifications until it turns them on again.
TETHER_VAPID_PRIVATE_KEY=
