<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Tether's web notifications (mail, reminders) are shown by this app, through Chrome's
         notification delegation to the DelegationService below. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <!-- Find the browsers that can host a Trusted Web Activity. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tether"
        android:manageSpaceActivity="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity">

        <!-- The app's half of Digital Asset Links; the site's half is /.well-known/assetlinks.json. -->
        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />

        <!-- The library's launcher, subclassed to sync the widgets when the app leaves the screen.
             Its settings are read from this activity's meta-data. -->
        <activity
            android:name=".TetherLauncherActivity"
            android:exported="true"
            android:label="@string/app_name">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/launch_url" />
            <!-- System bars match the page in light and dark mode. -->
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/page_light" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR_DARK"
                android:resource="@color/page_dark" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/page_light" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR_DARK"
                android:resource="@color/page_dark" />
            <meta-data android:name="android.support.customtabs.trusted.FALLBACK_TYPE"
                android:value="customtabs" />

            <!-- Tether's pages open in the app. Sign-in and OAuth paths are left out on purpose,
                 so the browser keeps them and logins finish where they started. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="@string/host" />
                <data android:pathPrefix="/inbox" />
                <data android:pathPrefix="/tasks" />
                <data android:pathPrefix="/calendar" />
                <data android:pathPrefix="/settings" />
            </intent-filter>
        </activity>

        <!-- The launcher icon, under the activity's old name: home-screen shortcuts made
             before the subclass point at this name and keep working. -->
        <activity-alias
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:targetActivity=".TetherLauncherActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- "Manage space" in the app's storage settings, and the site-settings shortcut the
             launcher adds: both open Chrome's data for the site. The launcher crashes without it. -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
            android:exported="false">
            <meta-data android:name="android.support.customtabs.trusted.MANAGE_SPACE_URL"
                android:value="@string/launch_url" />
        </activity>

        <!-- Widget sign-in: OAuth in a Chrome tab; the code returns to the app's own scheme. -->
        <activity
            android:name=".SignInActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Tether.Invisible" />
        <activity
            android:name=".RedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Tether.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.marstol.tether" android:path="/oauth2redirect" />
            </intent-filter>
        </activity>

        <activity
            android:name=".QuickAddActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tether.Dialog" />
        <activity
            android:name=".TasksConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tether.Dialog">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".InboxConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tether.Dialog">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver android:name=".data.ClockChangeReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widgets. -->
        <receiver android:name=".widget.TasksWidgetReceiver" android:exported="true" android:label="Tether tasks">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/tasks_widget_info" />
        </receiver>
        <receiver android:name=".widget.InboxWidgetReceiver" android:exported="true" android:label="Tether inbox">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/inbox_widget_info" />
        </receiver>
        <receiver android:name=".widget.AgendaWidgetReceiver" android:exported="true" android:label="Tether agenda">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/agenda_widget_info" />
        </receiver>
        <receiver android:name=".widget.DayWidgetReceiver" android:exported="true" android:label="Tether day">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/day_widget_info" />
        </receiver>

        <!-- Asks Android for the notification permission when the page asks for it. -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.NotificationPermissionRequestActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:exported="true"
            android:enabled="true">
            <meta-data android:name="android.support.customtabs.trusted.SMALL_ICON"
                android:resource="@drawable/ic_notification" />
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
